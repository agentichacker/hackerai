# GitHub repository for this deployment, as owner/repo. Release publishing,
# desktop updates, AUR packaging, repository links in the apps, and the default
# release source baked into the hosted install scripts read it.
# HACKERAI_REPOSITORY=your-org/hackerai

# Optional: publish releases from a different repository than the source tree.
# Falls back to HACKERAI_REPOSITORY when unset.
# HACKERAI_RELEASE_REPOSITORY=your-org/hackerai

# Optional: desktop update feed repository. Defaults to GITHUB_REPOSITORY, which
# GitHub Actions sets automatically; set it for local builds and Vercel builds.
# HACKERAI_DESKTOP_UPDATE_REPOSITORY=your-org/hackerai

# Optional: explicit release download root for mirrors that are not GitHub.
# HACKERAI_RELEASE_BASE_URL=https://downloads.example.com/hackerai

# Optional: HackerAI Connect source builds
# `cp .env.example .env` and fill in your own deployment's public identifiers to
# enable HackerAI Connect. These are public client identifiers, never secrets.
# Leave them unset to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Clerk instance for your deployment. Get these from the Clerk Dashboard under
# API keys, JWT templates, and OAuth applications.
# HACKERAI_CLERK_PUBLISHABLE_KEY=pk_test_your_instance
# HACKERAI_CLERK_JWT_TEMPLATE=your-relay-template
# HACKERAI_CLERK_CLI_OAUTH_CLIENT_ID=your_oauth_client_id

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in HACKERAI_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# HACKERAI_APPLE_TEAM_ID=ABC1234567
# HACKERAI_MACOS_PROVISIONING_PROFILE=/absolute/path/to/hackerai.provisionprofile
# HACKERAI_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Relay for your deployment. For a self-hosted relay, `infra/relay` deploys and
# updates it automatically.
# HACKERAI_RELAY_URL=https://relay.hackerai.sh

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://hackerai.sh; override to test against a staging deployment.
# HACKERAI_HOSTED_APP_URL=https://nightly.hackerai.sh

# Optional: remote provider model manifest. The app ships a bundled manifest and
# only refreshes from the network when this points at a JSON file you control.
# HACKERAI_MODEL_MANIFEST_URL=https://raw.githubusercontent.com/OWNER/REPO/main/apps/server/src/provider/model-manifest.json

# Product analytics is disabled until you provide your own PostHog project.
# HACKERAI_POSTHOG_KEY=phc_your_project_key
# HACKERAI_POSTHOG_HOST=https://ingest.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# HACKERAI_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# HACKERAI_MOBILE_OTLP_TRACES_DATASET=hackerai-code-mobile-traces-dev
# HACKERAI_MOBILE_OTLP_TRACES_TOKEN=xaat-...
